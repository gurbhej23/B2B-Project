# ==========================================
# APPLICATION & SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_WEB_URL=http://localhost:5173
MOBILE_APP_SCHEME=necessityb2b://

# ==========================================
# DATABASE (MONGODB ATLAS)
# ==========================================
# Provide MongoDB Atlas URI, or leave empty/local for auto-boot in-memory fallback
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/
MONGODB_DB_NAME=necessity_b2b

# ==========================================
# REDIS (SESSIONS, CACHE & LOCKS)
# ==========================================
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# ==========================================
# AUTHENTICATION & JWT SECURITY
# ==========================================
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=your_cookie_secret_salt_here

# ==========================================
# PAYMENT GATEWAY (MOCK / RAZORPAY / CASHFREE)
# ==========================================
PAYMENT_PROVIDER=mock_gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==========================================
# COMPANY BUSINESS & BANK DETAILS (TAX INVOICES / RTGS / NEFT)
# ==========================================
COMPANY_NAME="YOUR COMPANY NAME PRIVATE LIMITED"
COMPANY_ADDRESS="YOUR REGISTERED COMPANY ADDRESS"
COMPANY_GSTIN=00AAAAA0000A1Z5
COMPANY_BANK_NAME="YOUR BANK NAME"
COMPANY_BANK_ACCOUNT_NO=00000000000000
COMPANY_BANK_IFSC=BANK0000000
COMPANY_BANK_ACCOUNT_NAME="YOUR COMPANY NAME PRIVATE LIMITED"
COMPANY_UPI_VPA=company@bank

# ==========================================
# ZOHO BOOKS & INVENTORY INTEGRATION (OAUTH 2.0)
# ==========================================
ZOHO_ENABLED=false
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ORGANIZATION_ID=
ZOHO_REDIRECT_URI=http://localhost:5000/api/v1/integrations/zoho/callback
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_BASE_URL=https://www.zohoapis.in/books/v3

# ==========================================
# CLOUD STORAGE (LOCAL / S3 / CLOUDINARY)
# ==========================================
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================
# SMS / OTP PROVIDER
# ==========================================
SMS_PROVIDER=console
SMS_API_KEY=

# ==========================================
# EMAIL / SMTP PROVIDER (NODEMAILER)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Your Company <no-reply@yourcompany.com>"
SUPPORT_EMAIL=support@yourcompany.com
SUPPORT_PHONE="+91 00 0000 0000"
 